# AI 小车 systemd 服务单元 (可选 — 开机自启 + 崩溃自愈)
#
# 用途: 主程序异常退出 (如 dlib SIGSEGV / exit 139) 时由 systemd 自动拉起，
# 比 start.sh 的重启循环更适合无人值守运行。
#
# 安装步骤:
#   1. 按实际路径修改下面的 WorkingDirectory / ExecStart
#   2. sudo cp ai-car.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now ai-car
#
# 查看日志: journalctl -u ai-car -f

[Unit]
Description=AI Car main controller (mecanum wheel + vision + follow + hotspot)
After=network.target
# pigpiod 未做成 service 时注释掉下一行即可
Wants=pigpiod.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/pi-ai-car
# 启动小车前先开热点，停止后关热点 (手机直连传输控制更稳定)
ExecStartPre=/bin/bash -c 'nmcli connection delete ai-car-hotspot 2>/dev/null; nmcli connection add type wifi ifname wlan0 con-name ai-car-hotspot autoconnect no ssid car wifi-sec.key-mgmt wpa-psk wifi-sec.psk 13828287650 ipv4.method shared ipv6.method ignore && nmcli connection up ai-car-hotspot'
ExecStart=/home/pi/pi-ai-car/.venv/bin/python3 main.py
ExecStopPost=/bin/bash -c 'nmcli connection down ai-car-hotspot 2>/dev/null; nmcli connection delete ai-car-hotspot 2>/dev/null'
# 崩溃自愈: 任何退出 (含 SIGSEGV) 3 秒后重启
Restart=always
RestartSec=3
# 60 秒内重启超过 5 次则放弃 (防止配置错误导致的死循环重启)
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
